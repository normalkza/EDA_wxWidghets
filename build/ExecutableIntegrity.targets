<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 仅修复生成的 EXE；不修改工程目录或系统安全设置。 -->
  <UsingTask TaskName="WxDemoRepairExecutableIntegrity" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ExecutablePath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.ComponentModel;
using System.IO;
using System.Runtime.InteropServices;
using Microsoft.Build.Framework;

public sealed class WxDemoRepairExecutableIntegrity : Microsoft.Build.Utilities.Task
{
    [Required] public string ExecutablePath { get; set; }

    [DllImport("advapi32.dll", CharSet = CharSet.Unicode)]
    private static extern uint GetNamedSecurityInfoW(string name, int type, uint info,
        IntPtr owner, IntPtr group, IntPtr dacl, IntPtr sacl, out IntPtr descriptor);
    [DllImport("advapi32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    private static extern bool ConvertSecurityDescriptorToStringSecurityDescriptorW(
        IntPtr descriptor, uint revision, uint info, out IntPtr text, out uint length);
    [DllImport("kernel32.dll")] private static extern IntPtr LocalFree(IntPtr memory);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    private static extern bool MoveFileExW(string source, string target, uint flags);

    private static bool IsLow(string path)
    {
        IntPtr descriptor = IntPtr.Zero, text = IntPtr.Zero;
        try
        {
            uint error = GetNamedSecurityInfoW(path, 1, 0x10, IntPtr.Zero, IntPtr.Zero,
                IntPtr.Zero, IntPtr.Zero, out descriptor);
            if (error != 0) throw new Win32Exception((int)error);
            uint length;
            if (!ConvertSecurityDescriptorToStringSecurityDescriptorW(descriptor, 1, 0x10, out text, out length))
                throw new Win32Exception(Marshal.GetLastWin32Error());
            string sddl = Marshal.PtrToStringUni(text) ?? "";
            return sddl.IndexOf(";;;LW)", StringComparison.OrdinalIgnoreCase) >= 0 ||
                sddl.IndexOf(";;;S-1-16-4096)", StringComparison.OrdinalIgnoreCase) >= 0;
        }
        finally
        {
            if (text != IntPtr.Zero) LocalFree(text);
            if (descriptor != IntPtr.Zero) LocalFree(descriptor);
        }
    }

    public override bool Execute()
    {
        string staging = null;
        try
        {
            string executable = Path.GetFullPath(ExecutablePath);
            if (!File.Exists(executable) || !IsLow(executable)) return true;
            staging = Path.Combine(Path.GetTempPath(), "wx-demo-build-" + Guid.NewGuid().ToString("N"));
            Directory.CreateDirectory(staging);
            string candidate = Path.Combine(staging, Path.GetFileName(executable));
            // 新建文件按临时目录的普通权限写入，不复制来源的低完整性标签。
            DateTime modified = File.GetLastWriteTimeUtc(executable);
            using (var source = new FileStream(executable, FileMode.Open, FileAccess.Read, FileShare.Read))
            using (var target = new FileStream(candidate, FileMode.CreateNew, FileAccess.Write, FileShare.None))
            {
                source.CopyTo(target);
                target.Flush(true);
            }
            File.SetLastWriteTimeUtc(candidate, modified);
            if (IsLow(candidate)) throw new IOException("The temporary build directory also has a Low integrity label.");
            if (!string.Equals(Path.GetPathRoot(candidate), Path.GetPathRoot(executable), StringComparison.OrdinalIgnoreCase))
                throw new IOException("The temporary build directory must be on the same volume as the executable.");
            // 同卷原子移动保留正常文件描述符；不标记为 High，也不请求管理员权限。
            if (!MoveFileExW(candidate, executable, 0x1 | 0x8))
                throw new Win32Exception(Marshal.GetLastWin32Error());
            if (IsLow(executable)) throw new IOException("The generated executable still has a Low integrity label.");
            Log.LogMessage(MessageImportance.High, "Repaired inherited Low integrity label on {0}", executable);
            return true;
        }
        catch (Exception error)
        {
            Log.LogError("Cannot prepare the desktop executable: {0}", error.Message);
            return false;
        }
        finally
        {
            if (staging != null)
            {
                try
                {
                    foreach (string file in Directory.GetFiles(staging)) File.Delete(file);
                    Directory.Delete(staging, false);
                }
                catch { /* 只清理本任务创建的临时文件，不影响生成结果。 */ }
            }
        }
    }
}
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="WxDemoPrepareDesktopExecutable" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and Exists('$(TargetPath)')">
    <WxDemoRepairExecutableIntegrity ExecutablePath="$(TargetPath)" />
  </Target>
</Project>
