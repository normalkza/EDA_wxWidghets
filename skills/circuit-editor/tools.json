{
  "type": "function",
  "name": "edit_circuit",
  "description": "Apply one atomic batch of edits to existing or new canvas components, wires and text. Use current workspace references and named pins. The host validates and returns a fresh workspace for review.",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "summary",
      "operations"
    ],
    "properties": {
      "summary": {
        "type": "string",
        "maxLength": 2000
      },
      "operations": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "ref",
                "type",
                "inputCount",
                "x",
                "y"
              ],
              "properties": {
                "op": {
                  "type": "string",
                  "const": "add_component"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "INPUT",
                    "OUTPUT",
                    "BUTTON",
                    "LED",
                    "AND",
                    "OR",
                    "NOT",
                    "NAND",
                    "NOR",
                    "XOR",
                    "PROBE",
                    "CLOCK",
                    "CONSTANT",
                    "MUX",
                    "COMPARATOR",
                    "DFF"
                  ]
                },
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "inputCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16
                },
                "rotation": {
                  "type": "integer",
                  "enum": [
                    0,
                    90,
                    180,
                    270
                  ]
                },
                "high": {
                  "type": "boolean"
                },
                "clockPeriodNs": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 1000000000000000
                },
                "clockHighNs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000000000
                },
                "clockStartNs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000000
                },
                "probeLabel": {
                  "type": "string",
                  "maxLength": 128
                },
                "fallingEdge": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "ref"
              ],
              "properties": {
                "op": {
                  "type": "string",
                  "const": "update_component"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "inputCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16
                },
                "rotation": {
                  "type": "integer",
                  "enum": [
                    0,
                    90,
                    180,
                    270
                  ]
                },
                "high": {
                  "type": "boolean"
                },
                "clockPeriodNs": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 1000000000000000
                },
                "clockHighNs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000000000
                },
                "clockStartNs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000000
                },
                "probeLabel": {
                  "type": "string",
                  "maxLength": 128
                },
                "fallingEdge": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "ref"
              ],
              "properties": {
                "op": {
                  "type": "string",
                  "const": "delete_component"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "ref",
                "from",
                "outPin",
                "to",
                "inPin"
              ],
              "properties": {
                "op": {
                  "type": "string",
                  "const": "add_wire"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
                },
                "from": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
                },
                "outPin": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
                },
                "inPin": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "ref"
              ],
              "properties": {
                "op": {
                  "type": "string",
                  "const": "delete_wire"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "ref",
                "points"
              ],
              "properties": {
                "op": {
                  "type": "string",
                  "const": "route_wire"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
                },
                "points": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "ref",
                "x",
                "y",
                "width",
                "height",
                "text"
              ],
              "properties": {
                "op": {
                  "type": "string",
                  "const": "add_text"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "pointSize": {
                  "type": "integer",
                  "minimum": 6,
                  "maximum": 96
                },
                "text": {
                  "type": "string",
                  "maxLength": 4096
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "ref"
              ],
              "properties": {
                "op": {
                  "type": "string",
                  "const": "update_text"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "pointSize": {
                  "type": "integer",
                  "minimum": 6,
                  "maximum": 96
                },
                "text": {
                  "type": "string",
                  "maxLength": 4096
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "ref"
              ],
              "properties": {
                "op": {
                  "type": "string",
                  "const": "delete_text"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
                }
              }
            }
          ]
        }
      }
    }
  }
}
