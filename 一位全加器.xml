    <text x="40" y="20" width="860" height="42" pointSize="20">一位全加器 / 1-bit Full Adder</text>
    <text x="40" y="88" width="60" height="28" pointSize="14">A</text>
    <text x="80" y="168" width="60" height="28" pointSize="14">B</text>
