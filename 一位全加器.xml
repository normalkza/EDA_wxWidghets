    <text x="350" y="108" width="70" height="26" pointSize="12">P</text>
    <text x="250" y="210" width="195" height="28" pointSize="12">P = A ⊕ B</text>
    <text x="550" y="210" width="260" height="28" pointSize="12">Sum = P ⊕ Cin</text>
